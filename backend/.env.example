# Docker Postgres + pgvector (docker-compose.yml)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/ai_banking?schema=public"

JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="8h"

CF_ACCOUNT_ID=""
CF_API_TOKEN=""
CF_CHAT_MODEL="@cf/meta/llama-3.3-70b-instruct-fp8-fast"
# Must produce 768-dim vectors to match document_chunks.embedding
CF_EMBEDDING_MODEL="@cf/baai/bge-base-en-v1.5"

PORT=4000
CORS_ORIGIN="http://localhost:5173"
